# local = keys from this file (our demo); public or unset = the visitor pastes a key
PREMORTEM_MODE=local

LLM_API_KEY=
# Or one key per provider, to switch with LLM_PROVIDER only (the evaluation uses both:
# the gemini preset for the free run, anthropic for the judge). <PROVIDER>_API_KEY wins over LLM_API_KEY.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# Models. Leave all of these empty to use the anthropic preset:
#   Brief, Analyst, Strategist, Creative, Validator: anthropic:claude-sonnet-5-5
#   Blueprint executive summary:                     anthropic:claude-opus-5-5
#   Evaluation judge (eval/metrics.py):              anthropic:claude-haiku-5-5
# Presets: anthropic, gemini, openai, mistral, groq, openrouter (premortem/providers.py)
LLM_PROVIDER=
# LLM_MODEL replaces the model of every role (e.g. anthropic:claude-sonnet-5-5); one role at a time:
LLM_MODEL=
LLM_MODEL_BRIEF=
LLM_MODEL_ANALYST=
LLM_MODEL_STRATEGIST=
LLM_MODEL_CREATIVE=
LLM_MODEL_VALIDATOR=
LLM_MODEL_BLUEPRINT=
LLM_JUDGE_MODEL=   # the evaluation judge; empty = the preset's (Haiku for anthropic)
LLM_BASE_URL=   # any OpenAI-compatible endpoint, with LLM_MODEL=openai:<model>

# Optional
LLM_TEMPERATURE=   # leave empty for models that reject it (e.g. Claude 5)
LLM_JUDGE_TEMPERATURE=   # Validator and evaluation judge, e.g. 0 for models that accept it
LANGSMITH_API_KEY=
